{
  "name": "@dice-roller/3d",
  "version": "1.0.0",
  "description": "Three.js 3D dice animation plugin for @dice-roller",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly",
    "preview": "vite preview"
  },
  "keywords": [
    "dice",
    "dice-roller",
    "3d",
    "threejs",
    "animation",
    "physics",
    "webgl"
  ],
  "author": "Logan <logan@phantasea.net>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rakmaster/dice-roller-3d.git"
  },
  "homepage": "https://rakmaster.github.io/dice-roller-3d/",
  "bugs": {
    "url": "https://github.com/rakmaster/dice-roller-3d/issues"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
